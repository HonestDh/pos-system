{
  "name": "pos",
  "version": "1.0.0",
  "description": "POS System for Windows Tablet",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"npm run dev\" \"npm run electron\"",
    "dev": "webpack serve --mode development",
    "electron": "electron .",
    "build": "webpack --config webpack.config.js --mode production",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "keywords": [
    "pos",
    "payment",
    "tablet"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "node-thermal-printer": "^4.6.1",
    "nodemailer": "^9.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "autoprefixer": "^10.4.15",
    "babel-loader": "^9.1.32",
    "concurrently": "^8.2.0",
    "copy-webpack-plugin": "^11.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "electron": "^25.9.8",
    "electron-builder": "^23.6.0",
    "electron-is-dev": "^2.0.0",
    "electron-rebuild": "^3.2.9",
    "html-webpack-plugin": "^5.6.8",
    "postcss": "^8.4.28",
    "postcss-loader": "^7.3.3",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.3.5",
    "wait-on": "^7.2.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "build": {
    "appId": "com.pos.system",
    "productName": "POS System",
    "files": [
      "main.js",
      "public/**/*",
      "node_modules/**/*",
      "!node_modules/**/*.map",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme,test,**/test/**}"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
